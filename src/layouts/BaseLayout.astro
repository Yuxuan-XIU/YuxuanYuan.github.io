---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "zh";
}

const {
  title = `${site.name} · Exoplanet Researcher`,
  description = "Yuxuan Yuan is a PhD student in astronomy at Tsinghua University studying exoplanet atmospheres, detection, and orbital dynamics.",
  lang = "en"
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const isZh = lang === "zh";
const languagePrefix = isZh ? "zh/" : "";
const relativePath = currentPath.startsWith(base) ? currentPath.slice(base.length) : "";
const counterpartPath = isZh ? relativePath.replace(/^zh\/?/, "") : `zh/${relativePath}`;
const languageHref = `${base}${counterpartPath}`;
const englishPath = isZh ? `${base}${relativePath.replace(/^zh\/?/, "")}` : currentPath;
const chinesePath = isZh ? currentPath : `${base}zh/${relativePath}`;
const ogImage = new URL(`${base}og.jpg`, Astro.site);
const navItems = [
  [isZh ? "关于" : "About", "about/"],
  [isZh ? "研究" : "Research", "research/"],
  [isZh ? "科普" : "Outreach", "outreach/"],
  [isZh ? "其他" : "Stuffs", "stuffs/"]
] as const;
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b14" id="theme-color" />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('site-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(chinesePath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(englishPath, Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isZh ? "跳到正文" : "Skip to content"}</a>
    <header class="site-header">
      <a class="wordmark" href={`${base}${languagePrefix}`} aria-label={isZh ? "袁雨轩，中文首页" : `${site.name}, home`}>
        <span class="wordmark-orbit" aria-hidden="true"><i></i></span>
        <span>YUXUAN YUAN</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span>{isZh ? "菜单" : "Menu"}</span>
      </button>
      <nav id="site-navigation" aria-label="Primary navigation">
        {navItems.map(([label, path]) => (
          <a class:list={{ active: currentPath.includes(`/${languagePrefix}${path}`) }} href={`${base}${languagePrefix}${path}`}>{label}</a>
        ))}
        <button class="theme-toggle" type="button" aria-label="Switch color theme">
          <span class="theme-toggle-icon" aria-hidden="true"></span>
          <span class="theme-toggle-label">{isZh ? "浅色" : "Light"}</span>
        </button>
        <a class="language-toggle" href={languageHref} hreflang={isZh ? "en" : "zh-CN"}>{isZh ? "EN" : "中文"}</a>
        <a class="nav-cv" href={site.cv} target="_blank" rel="noreferrer">{isZh ? "简历" : "CV"} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <p class="footer-mark">YUXUAN YUAN</p>
        <p>{isZh ? "系外行星研究者 · 清华大学" : "Exoplanet researcher · Tsinghua University"}</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <p class="footer-meta">© {new Date().getFullYear()} Yuxuan Yuan</p>
    </footer>
    <script is:inline>
      const menuToggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-navigation');
      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });

      const themeToggle = document.querySelector('.theme-toggle');
      const themeLabel = document.querySelector('.theme-toggle-label');
      const themeColor = document.querySelector('#theme-color');
      const languageToggle = document.querySelector('.language-toggle');
      const isChinese = document.documentElement.lang.startsWith('zh');

      const updateThemeControl = () => {
        const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        if (themeLabel) themeLabel.textContent = isChinese
          ? (next === 'light' ? '浅色' : '深色')
          : (next === 'light' ? 'Light' : 'Dark');
        const action = isChinese ? `切换为${next === 'light' ? '浅色' : '深色'}主题` : `Switch to ${next} theme`;
        themeToggle?.setAttribute('aria-label', action);
        themeToggle?.setAttribute('title', action);
        themeColor?.setAttribute('content', current === 'light' ? '#f4f7f9' : '#070b14');
      };

      updateThemeControl();
      themeToggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('site-theme', next); } catch {}
        updateThemeControl();
      });

      if (languageToggle && window.location.hash) {
        languageToggle.setAttribute('href', `${languageToggle.getAttribute('href')}${window.location.hash}`);
      }
    </script>
  </body>
</html>
