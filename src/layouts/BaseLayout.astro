---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · Exoplanet Researcher`,
  description = "Yuxuan Yuan is a PhD student in astronomy at Tsinghua University studying exoplanet atmospheres, detection, and orbital dynamics."
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const ogImage = new URL(`${base}og.jpg`, Astro.site);
const navItems = [
  ["About", "about/"],
  ["Research", "research/"],
  ["Outreach", "outreach/"],
  ["Stuffs", "stuffs/"]
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b14" id="theme-color" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('site-theme');
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label={`${site.name}, home`}>
        <span class="wordmark-orbit" aria-hidden="true"><i></i></span>
        <span>YUXUAN YUAN</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span>Menu</span>
      </button>
      <nav id="site-navigation" aria-label="Primary navigation">
        {navItems.map(([label, path]) => (
          <a class:list={{ active: currentPath.includes(`/${path}`) }} href={`${base}${path}`}>{label}</a>
        ))}
        <button class="theme-toggle" type="button" aria-label="Switch color theme">
          <span class="theme-toggle-icon" aria-hidden="true"></span>
          <span class="theme-toggle-label">Light</span>
        </button>
        <a class="nav-cv" href={site.cv} target="_blank" rel="noreferrer">CV <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <p class="footer-mark">YUXUAN YUAN</p>
        <p>Exoplanet researcher · Tsinghua University</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <p class="footer-meta">© {new Date().getFullYear()} Yuxuan Yuan</p>
    </footer>
    <script is:inline>
      const menuToggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-navigation');
      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });

      const themeToggle = document.querySelector('.theme-toggle');
      const themeLabel = document.querySelector('.theme-toggle-label');
      const themeColor = document.querySelector('#theme-color');

      const updateThemeControl = () => {
        const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        if (themeLabel) themeLabel.textContent = next === 'light' ? 'Light' : 'Dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${next} theme`);
        themeToggle?.setAttribute('title', `Switch to ${next} theme`);
        themeColor?.setAttribute('content', current === 'light' ? '#f4f7f9' : '#070b14');
      };

      updateThemeControl();
      themeToggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('site-theme', next);
        updateThemeControl();
      });
    </script>
  </body>
</html>
