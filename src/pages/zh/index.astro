---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { zhResearchAreas, zhProjects } from "../../data/zh";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  lang="zh"
  title="袁宇轩 · 系外行星研究"
  description="袁宇轩，清华大学天文学博士生，研究系外行星探测、大气与轨道动力学。"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> 系外行星研究 · 清华大学</p>
      <h1>寻找<br /><em>另一个世界。</em></h1>
      <p class="hero-intro">
        我是袁宇轩，清华大学天文学博士生，研究系外行星。<br />
        我关注如何发现系外行星、它们的大气能告诉我们什么，以及行星系统如何演化。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}zh/research/`}>探索我的研究 <span aria-hidden="true">→</span></a>
        <a class="button button-quiet" href={`${base}zh/about/`}>了解更多</a>
      </div>
    </div>

    <div class="hero-visual" aria-label="袁宇轩的照片">
      <div class="portrait-frame">
        <img src={`${base}assets/yuxuan-huangshan.jpg`} alt="袁宇轩在黄山徒步" />
      </div>
      <div class="coordinate-label coordinate-top" aria-hidden="true">30.1318° N · 118.1685° E</div>
      <div class="coordinate-label coordinate-side" aria-hidden="true">寻找信号</div>
      <div class="planet-marker" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="research-intro shell" aria-labelledby="research-heading">
    <div class="section-heading">
      <p class="section-kicker">研究方向</p>
      <h2 id="research-heading">从三个方向<br />认识遥远的行星。</h2>
    </div>
    <div class="research-grid">
      {zhResearchAreas.map((area) => (
        <article class="research-area">
          <p class="area-index">{area.index}</p>
          <h3>{area.title}</h3>
          <p>{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-projects shell" aria-labelledby="projects-heading">
    <div class="section-heading section-heading-compact">
      <p class="section-kicker">精选工作</p>
      <div>
        <h2 id="projects-heading">研究亮点。</h2>
        <a class="text-link" href={`${base}zh/research/`}>查看全部研究 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="project-preview-grid">
      {zhProjects.slice(0, 2).map((project) => (
        <article class="project-preview">
          <a href={`${base}zh/research/#${project.slug}`}>
            <div class="preview-image light-figure">
              <img src={`${base}${project.images[0].src}`} alt={project.images[0].alt} loading="lazy" />
            </div>
            <div class="preview-copy">
              <p>{project.eyebrow} <span>·</span> {project.status}</p>
              <h3>{project.title}</h3>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-outreach shell">
    <p class="section-kicker">研究之外</p>
    <div>
      <h2>让每个人都能遇见系外行星。</h2>
      <p>无论是在母校分享系外行星，还是在妇女节谈论天文与学术生活，我都希望让宇宙显得更近、更亲切，也向每个人敞开。</p>
      <a class="button button-quiet" href={`${base}zh/outreach/`}>查看科普活动 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
