---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
---

<BaseLayout lang="zh" title="其他 · 袁宇轩" description="袁宇轩的笔记、资源、小项目与其他内容。">
  <SectionIntro
    eyebrow="其他"
    title="笔记、链接，以及无处归类的事物。"
    intro="这里将逐渐收纳阅读笔记、小实验、研究工具，以及天文生活之外偶尔出现的想法。"
  />

  <section class="misc-grid shell">
    <article class="misc-feature">
      <p class="section-kicker">笔记与博客</p>
      <h2>来自光变曲线边缘的现场笔记。</h2>
      <p>这里将用于分享论文笔记、研究工作流、会议随想，以及关于系外行星的长文章。第一篇仍在轨道上。</p>
      <span class="coming-label">即将开始写作</span>
    </article>
    <article class="misc-small">
      <p class="section-kicker">小项目</p>
      <h2>实验<br />与笔记本</h2>
      <p>一些小型模拟、实用代码和视觉创意，会在准备好分享时逐渐收集到这里。</p>
    </article>
  </section>
</BaseLayout>
