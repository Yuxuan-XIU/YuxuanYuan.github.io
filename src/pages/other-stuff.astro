---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const destination = `${base}stuffs/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Redirecting to Stuffs · Yuxuan Yuan</title>
  </head>
  <body>
    <p>Redirecting to <a href={destination}>Stuffs</a>…</p>
  </body>
</html>
