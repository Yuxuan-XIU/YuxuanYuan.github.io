---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="About · Yuxuan Yuan" description="About Yuxuan Yuan, a PhD student in astronomy at Tsinghua University.">
  <section class="about-profile shell">
    <div class="about-photo">
      <div class="about-photo-frame">
        <img src={`${base}assets/yuxuan-ditang.jpg`} alt="Yuxuan Yuan visiting the Temple of Earth in Beijing" />
      </div>
      <p>At the Ditan Book Fair in Beijing’s Temple of Earth Park, where I found a pocket edition of <em>The Lord of the Rings</em> to add to my collection.</p>
    </div>
    <div class="about-copy">
      <header class="about-heading">
        <p class="eyebrow"><span></span>About</p>
        <h1>Exoplanet explorer.</h1>
        <p class="about-intro">I am a PhD student at Tsinghua University, working on exoplanet detection, atmospheres, and orbital dynamics.</p>
      </header>
      <section class="education" aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <ol>
          <li>
            <time>2026—present</time>
            <div><h3>Ph.D. in Astronomy</h3><p>Tsinghua University</p></div>
          </li>
          <li>
            <time>2022—2026</time>
            <div><h3>B.S. in Astronomy</h3><p>University of Science and Technology of China</p></div>
          </li>
        </ol>
      </section>
      <p class="lead">I was born in Ji’an, Jiangxi, and grew up in a small contryside. Far from the glow of city lights, I grew up beneath the star-filled skies of southern China. Also, I’m a fan of Science fictions. That early curiosity and the love for science fictions eventually led me to astronomy.</p>
      <p>Beyond research, I enjoy stand-up comedy and sketch comedy. I have always wanted to try performing at an open mic someday —— becoming a comedian might just be my second dream. I also enjoy writing stories and building small apps for my friends.  </p>
      <div class="about-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="button button-quiet" href={site.cv} target="_blank" rel="noreferrer">Read my CV <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact-strip shell">
    <p>Have an interesting question?</p>
    <a href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
