---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Outreach · Yuxuan Yuan" description="Astronomy outreach and public talks by Yuxuan Yuan.">
  <SectionIntro
    eyebrow="Outreach"
    title="Sharing stories of exoplanets."
    intro="I believe that knowledge should be accessible to everyone. Through public talks and outreach, I share stories of exoplanets with people from different backgrounds, creating spaces where anyone can encounter astronomy with curiosity and on their own terms."
  />

  <section class="outreach-stories shell" aria-label="Outreach stories">
    <article class="outreach-story">
      <div class="story-index">
        <span>01</span>
        <p>Women’s Day<br />Small gathering</p>
      </div>
      <div class="story-copy">
        <p class="section-kicker">Talk</p>
        <h2>“Playing Academia”</h2>
        <p>I gave a talk at <em>Xueshu Guojiajia</em> (“Playing Academia”), a small gathering held around International Women’s Day. It was an opportunity to share, reflect, and talk about life around academic work in a more open and informal setting.</p>
        <p class="story-note">Talk materials and photographs will be added here later.</p>
      </div>
      <div class="story-visual story-visual-talk" aria-hidden="true">
        <span class="signal signal-a"></span>
        <span class="signal signal-b"></span>
        <span class="signal signal-c"></span>
        <b>∞</b>
      </div>
    </article>

    <article class="outreach-story outreach-story-reverse">
      <div class="story-index">
        <span>02</span>
        <p>Luotian High School<br />Exoplanet outreach</p>
      </div>
      <div class="story-copy">
        <p class="section-kicker">School visit</p>
        <h2>Taking exoplanets back to my middle school.</h2>
        <p>Could there be aliens beyond Earth—and if so, how would we ever find them? At Luotian Middle School, my former school in the countryside, I started the journey with this question. Together, we ventured beyond our Solar System: how we discover exoplanets, what we can learn from their light, and how these distant worlds might bring us closer to answering one of humanity’s oldest questions—are we alone?</p>
        <p class="story-note">An introduction to exoplanets for students at Luotian High School.</p>
      </div>
      <div class="story-visual story-visual-photo">
        <img
          src={`${base}assets/outreach/luotian-high-school-talk.jpg`}
          alt="Yuxuan Yuan giving an exoplanet outreach talk to students at Luotian High School"
          loading="lazy"
        />
      </div>
    </article>
  </section>
</BaseLayout>
